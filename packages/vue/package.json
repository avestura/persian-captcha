{
  "name": "@persian-captcha/vue",
  "version": "0.1.0",
  "description": "Vue 3 component for the Persian Captcha widget",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
