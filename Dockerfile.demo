# The demo site from cmd/demo, so `docker compose up` gives something to click.
# It is a development aid and has no place in a production deployment.

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-s -w" -o /out/demo ./cmd/demo

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/demo /demo
EXPOSE 5173
USER nonroot:nonroot
# -captcha must be a URL the *browser* can reach, because the widget script
# and the iframe are loaded by the visitor, not by this container. -verify is
# dialled by this process instead, so under compose it wants the service name
# rather than localhost; see docker-compose.demo.yml.
ENTRYPOINT ["/demo", "-listen", ":5173"]
CMD ["-captcha", "http://localhost:8080"]
